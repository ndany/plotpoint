{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndany/plotpoint/schemas/plotpoint.schema.json",
  "title": "plotpoint visualize: requests and results",
  "description": "Validate a document against one $defs entry: storyboardRequest, storyboardResult, renderRequest or renderResult. Field meanings: references/spec.md.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "target": {
      "enum": [
        "md/document",
        "html/document",
        "html/slide",
        "image/slide"
      ]
    },
    "technique": {
      "enum": [
        "svg",
        "mermaid",
        "table",
        "text",
        "vega",
        "png"
      ]
    },
    "visualType": {
      "type": "string",
      "description": "v1 renders bar, stacked_bar, line, scatter, histogram, table, number, sentence. Other chooser types are valid in a storyboard; the renderer refuses them, so draw them by hand following dataviz.",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "data": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\.(csv|tsv|json|jsonl)$"
        },
        "inline": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "layoutSpec": {
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "prose",
            "report",
            "wide",
            "dashboard",
            "deck",
            "slide-image"
          ]
        },
        "content_width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 4000
        },
        "height": {
          "type": "integer",
          "minimum": 120,
          "maximum": 3000
        },
        "min_display_width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 4000
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "description": "A layout for all targets, or a map from target to layout.",
      "oneOf": [
        {
          "$ref": "#/$defs/layoutSpec"
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/target"
          },
          "additionalProperties": {
            "$ref": "#/$defs/layoutSpec"
          }
        }
      ]
    },
    "fields": {
      "type": "object",
      "properties": {
        "x": {
          "type": "string"
        },
        "y": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "series": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sort": {
          "enum": [
            "value",
            "data",
            "label"
          ]
        },
        "orientation": {
          "enum": [
            "vertical",
            "horizontal",
            "auto"
          ]
        },
        "normalize": {
          "type": "boolean"
        },
        "bins": {
          "type": "integer",
          "minimum": 2,
          "maximum": 200
        },
        "names": {
          "type": "object",
          "description": "Display names for columns, e.g. {ebook: E-book}",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "callout": {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "point",
            "note"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": [
            "string",
            "number"
          ],
          "description": "Where the callout is pinned: an x-axis value (line, bar, stacked bar), or a numeric x value (scatter, histogram rule)."
        },
        "series": {
          "type": "string",
          "description": "Point callouts: the series (column or display name) on line and bar charts; the point's label (fields.label value) or series on a scatter."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rule"
              }
            }
          },
          "then": {
            "required": [
              "x"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "point"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "x"
                ]
              },
              {
                "required": [
                  "series"
                ]
              }
            ]
          }
        }
      ]
    },
    "outlierHandling": {
      "description": "One handling for every flagged column, or a list with one entry per column.",
      "oneOf": [
        {
          "$ref": "#/$defs/outlierHandlingEntry"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outlierHandlingEntry"
          }
        }
      ]
    },
    "intent": {
      "type": "object",
      "required": [
        "visual_type",
        "headline",
        "headline_status"
      ],
      "properties": {
        "visual_type": {
          "$ref": "#/$defs/visualType"
        },
        "rationale": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "headline_status": {
          "enum": [
            "confirmed",
            "draft",
            "title"
          ],
          "description": "confirmed: the caller's takeaway. draft: written by plotpoint, needs a person to confirm. title: a descriptive label for a reference visual (e.g. an appendix table) that carries no single takeaway."
        },
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "highlight": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callout"
          }
        },
        "outlier_handling": {
          "$ref": "#/$defs/outlierHandling"
        },
        "units": {
          "type": "string",
          "description": "Title for the measure axis: the y axis of line, bar and stacked bar charts, the x axis (the measured value) of a histogram. Name the measure and its unit, e.g. 'Wait (minutes)'. Scatter axes use fields.names."
        }
      },
      "additionalProperties": false
    },
    "colorMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(accent|context|slot[1-8]|#[0-9a-fA-F]{6})$"
      }
    },
    "storyboardRequest": {
      "type": "object",
      "required": [
        "writeup",
        "questions",
        "datasets"
      ],
      "properties": {
        "writeup": {
          "type": "object",
          "required": [
            "audiences",
            "default_audience",
            "targets"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "audiences": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/id"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "default_audience": {
              "$ref": "#/$defs/id"
            },
            "targets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/target"
              },
              "minItems": 1
            },
            "layout": {
              "$ref": "#/$defs/layout"
            },
            "draft": {
              "$ref": "#/$defs/draft"
            }
          },
          "additionalProperties": false
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "datasets"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              },
              "takeaway": {
                "type": "string"
              },
              "datasets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "data",
              "source",
              "as_of"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "data": {
                "$ref": "#/$defs/data"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "as_of": {
                "$ref": "#/$defs/date"
              },
              "units": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "storyboardResult": {
      "type": "object",
      "required": [
        "visuals",
        "recommendations",
        "color_map"
      ],
      "properties": {
        "visuals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "questions",
              "datasets",
              "audience",
              "placement",
              "intent",
              "renderings"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "questions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              },
              "datasets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              },
              "audience": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              },
              "placement": {
                "enum": [
                  "summary",
                  "body",
                  "appendix"
                ]
              },
              "intent": {
                "$ref": "#/$defs/intent"
              },
              "renderings": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/target"
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "technique"
                  ],
                  "properties": {
                    "technique": {
                      "$ref": "#/$defs/technique"
                    },
                    "compensations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "data": {
                "$ref": "#/$defs/data",
                "description": "The table to render from, when it isn't one dataset as given (a merge or a derived table). Describe how to build it in data_note."
              },
              "data_note": {
                "type": "string",
                "description": "How the caller builds the render data (join, filter, derived columns)."
              }
            },
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "detail",
              "affects"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "order",
                  "merge",
                  "demote",
                  "cut",
                  "add-summary",
                  "placement",
                  "rendering",
                  "other"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "affects": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "color_map": {
          "$ref": "#/$defs/colorMap"
        }
      },
      "additionalProperties": false
    },
    "renderRequest": {
      "type": "object",
      "required": [
        "data",
        "source",
        "as_of",
        "targets"
      ],
      "anyOf": [
        {
          "required": [
            "intent"
          ]
        },
        {
          "required": [
            "question"
          ]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "question": {
          "type": "string"
        },
        "takeaway": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1
        },
        "technique": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/target"
          },
          "additionalProperties": {
            "$ref": "#/$defs/technique"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "color_map": {
          "$ref": "#/$defs/colorMap"
        },
        "out_dir": {
          "type": "string"
        },
        "md_table": {
          "type": "boolean",
          "description": "Also add a values table under Markdown charts"
        }
      },
      "additionalProperties": false
    },
    "renderResult": {
      "type": "object",
      "required": [
        "id",
        "intent",
        "outputs",
        "checks",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/target"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "technique",
              "files",
              "snippet"
            ],
            "properties": {
              "technique": {
                "$ref": "#/$defs/technique"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "snippet": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "warn",
                  "fail",
                  "skip"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "description": "The draft write-up: a Markdown or HTML file path, or inline text",
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\.(md|markdown|html|htm|txt)$"
        },
        "inline": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outlierHandlingEntry": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "none_flagged",
            "callout",
            "log_scale",
            "exclude",
            "accept"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "reason": {
          "type": "string"
        },
        "column": {
          "type": "string",
          "description": "The flagged column this entry handles. Omit for one handling that covers every column."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "exclude"
              }
            }
          },
          "then": {
            "required": [
              "exclude",
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "accept"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
